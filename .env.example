# CoFi Loan Management App – Environment
# Copy to .env and adjust as needed

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://cofi-bms-api-production.up.railway.app/api/v1

# Expo Go compatibility (default true). Metro substitutes a no-op push module so
# Android Expo Go does not crash on launch. Set to false for EAS dev/production builds.
EXPO_PUBLIC_EXPO_GO_COMPAT=true

# Google Maps API key for native Properties Map (Android/iOS EAS builds).
# Required for react-native-maps Google provider tiles outside Expo Go.
# Create a key with Maps SDK for Android / Maps SDK for iOS enabled.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Metro/CLI only — does NOT affect the app on device. Use when Windows dev machine
# cannot reach Expo API (e.g. debugger-frontend fetch failed):
# EXPO_OFFLINE=1
# Or pass: npx expo start --offline
